# .env.example — Environment configuration for the Tinker AFB Risk Assessment API
#
# Copy this file to api/.env and set values as needed.
# All settings have safe defaults; only configure what you need.
#
# ─── Application ──────────────────────────────────────────────────────────────

PROJECT_NAME="Tinker AFB AI Risk Assessment System"
VERSION="0.4.0"

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use the local SQLite database (default for dev/demo).
# Set to a PostgreSQL connection string for production deployment.
# Example: postgresql://user:password@localhost:5432/risk_assessment_db

DATABASE_URL=""

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to call the API. Add your production frontend URL here.

BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# ─── Authentication ───────────────────────────────────────────────────────────
# Option A — API Key (simple, stateless)
#   Set API_KEY to any secret string. The frontend must send it as the
#   X-API-Key request header (configured in frontend/.env as VITE_API_KEY).
#   Leave blank to run in open/dev mode with no authentication.

API_KEY=""

# Option B — JWT User Auth (role-based: viewer / analyst / supervisor)
#   Set JWT_SECRET_KEY to a long random string (e.g. openssl rand -hex 32).
#   Users are configured in api/core/auth.py.
#   Leave blank to disable JWT and fall back to API_KEY or open mode.

JWT_SECRET_KEY=""

# ─── Admin ────────────────────────────────────────────────────────────────────
# Password for the admin panel unlock feature in the frontend header.
# Leave blank to disable admin panel access.

ADMIN_MASTER_PASSWORD=""
